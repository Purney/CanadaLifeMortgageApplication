@inherits LayoutComponentBase
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
    <div class="header-inner">
        <a class="brand" href="/" aria-label="Canada Life mortgage demo home">
            <span class="brand-wordmark">Canada Life</span>
            <span class="brand-divider" aria-hidden="true"></span>
            <span class="brand-product">Mortgages</span>
        </a>
        <nav aria-label="Main navigation">
            <NavLink href="/applications/new" class="nav-link">New application</NavLink>
            <NavLink href="/applications/find" class="nav-link">Find application</NavLink>
        </nav>
    </div>
</header>
<main id="main-content">@Body</main>
<footer class="site-footer">
    <div class="footer-inner">
        <a href="/" class="footer-brand">Canada Life <span>Mortgages</span>
        </a>
        <p>Technical exercise · Illustrative assessments, not lending offers.</p>
    </div>
</footer>
<div id="blazor-error-ui" data-nosnippet>Your connection was interrupted. <a href="." class="reload">Reload page</a>
    <button class="dismiss" aria-label="Dismiss">×</button>
</div>
