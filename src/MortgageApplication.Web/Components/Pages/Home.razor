@page "/"
<PageTitle>Mortgage applications | Canada Life demo</PageTitle>
<section class="home-hero">
    <div class="hero-inner">
        <div class="hero-copy">
            <p class="eyebrow">MORTGAGE APPLICATIONS</p>
            <h1>Your mortgage.<br />A clear next step.</h1>
            <p class="hero-description">Submit your details, understand affordability and keep a clear record of every assessment.</p>
            <div class="button-row">
                <a href="/applications/new" class="button button-white">Start an application <span aria-hidden="true">→</span>
                </a>
                <a href="/applications/find" class="hero-secondary">Find an application <span aria-hidden="true">↗</span>
                </a>
            </div>
        </div>
        <div class="hero-art" aria-hidden="true">
            <div class="art-disc">
            </div>
            <svg viewBox="0 0 400 330" fill="none">
                <path
                    d="M44 164 198 40l155 124M82 138v160h233V138M160 298V186h77v112M101 101V50h38v21"
                    stroke="currentColor"
                    stroke-width="5"
                    stroke-linejoin="round"/>
                <path d="M108 187h28v43h-28zM263 187h28v43h-28z" stroke="currentColor" stroke-width="4"/>
                <path d="M54 299h291M36 315h326" stroke="currentColor" stroke-width="3"/>
                <circle cx="218" cy="243" r="3" fill="currentColor"/>
                <path d="M327 52v36m-18-18h36M45 220v24m-12-12h24" stroke="currentColor" stroke-width="3"/>
            </svg>
            <span class="art-caption">A little clarity. A lot of possibility.</span>
        </div>
    </div>
</section>
<section class="content-shell home-content">
    <div class="section-heading">
        <div>
            <p class="eyebrow red-text">A SIMPLE WAY FORWARD</p>
            <h2>From your details to a clearer picture.</h2>
        </div>
        <p>Everything you need to explore a mortgage application, in three straightforward steps.</p>
    </div>
    <div class="steps-grid">
        <a href="/applications/new" class="step-card">
            <span class="step-number">01</span>
            <h3>Tell us the essentials</h3>
            <p>Your income, debt payments, deposit, property value and mortgage term.</p>
            <span class="text-link">Create an application <span aria-hidden="true">→</span>
            </span>
        </a>
        <div class="step-card">
            <span class="step-number">02</span>
            <h3>See your affordability</h3>
            <p>Run an assessment to see your borrowing estimate and the reasons behind the decision.</p>
            <span class="step-footnote">Available from your saved application</span>
        </div>
        <a href="/applications/find" class="step-card">
            <span class="step-number">03</span>
            <h3>Keep the full picture</h3>
            <p>Return to your application and explore its saved assessment history.</p>
            <span class="text-link">Find your application <span aria-hidden="true">→</span>
            </span>
        </a>
    </div>
    <div class="demo-note">
        <span class="info-symbol" aria-hidden="true">i</span>
        <p>This demonstration uses simplified affordability rules. Amounts are shown in pounds sterling; results are illustrative and aren't mortgage offers.</p>
    </div>
</section>
